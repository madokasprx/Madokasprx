name: Build Luma.prx
on:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-22.04
    steps:
      - uses: actions/checkout@v4
      - name: Install build tools
        run: |
          sudo apt-get update
          sudo apt-get install -y clang lld cmake ninja-build binutils libicu-dev
      - name: Download OpenOrbis toolchain
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          mkdir -p "$HOME/oo" /tmp/oo
          gh release download --repo OpenOrbis/OpenOrbis-PS4-Toolchain --pattern '*.tar.gz' --dir /tmp/oo
          ls -la /tmp/oo
          tar -xzf /tmp/oo/*.tar.gz -C "$HOME/oo"
          ls "$HOME/oo"
      - name: Build Luma
        run: |
          # the release may unpack into a sub-folder; find the folder that holds lib/ and include/
          ROOT=$(dirname "$(find "$HOME/oo" -maxdepth 3 -type d -name lib | head -1)")
          echo "toolchain root: $ROOT"
          export OO_PS4_TOOLCHAIN="$ROOT"
          chmod +x "$ROOT"/bin/linux/* || true
          bash ./build.sh
      - name: Upload plugin
        uses: actions/upload-artifact@v4
        with:
          name: Luma-prx
          path: |
            build/Luma.prx
            build/Luma.elf
